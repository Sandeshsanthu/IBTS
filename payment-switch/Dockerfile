# Code Generated by Sidekick is for learning and experimentation purposes only.
# filename: payment-switch/Dockerfile

FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# wget needed for healthcheck (slim has no curl)
RUN apt-get update && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8083

# init DynamoDB table + SQS queue at startup, then launch on correct port
CMD ["sh", "-c", "python init_resources.py && uvicorn main:app --host 0.0.0.0 --port 8083"]
