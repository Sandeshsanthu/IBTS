# Code Generated by Sidekick is for learning and experimentation purposes only.
# filename: payment-switch/Dockerfile

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /service

COPY shared/ /ibts-shared/
RUN pip install --no-cache-dir /ibts-shared/

COPY payment-switch/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY payment-switch/app/ ./app/
COPY payment-switch/main.py ./main.py

EXPOSE 8083
CMD ["sh", "-c", "python app/init_resources.py && uvicorn main:app --host 0.0.0.0 --port 8083"]
