# filename: infra-aws/stage2-apps/alb-nodeport-rule.tf
# Code Generated by Sidekick is for learning and experimentation purposes only.

data "aws_eks_cluster" "eks" {
  name = var.cluster_name
}

data "aws_security_group" "alb_backend_sg" {
  filter {
    name   = "tag:elbv2.k8s.aws/cluster"
    values = [var.cluster_name]
  }
  filter {
    name   = "tag:elbv2.k8s.aws/resource"
    values = ["backend-sg"]
  }
}

resource "aws_security_group_rule" "allow_alb_to_nodes_nodeport" {
  type                     = "ingress"
  from_port                = 30000
  to_port                  = 32767
  protocol                 = "tcp"
  security_group_id        = data.aws_eks_cluster.eks.vpc_config[0].cluster_security_group_id
  source_security_group_id = data.aws_security_group.alb_backend_sg.id
  description              = "Allow ALB backend SG to reach node NodePorts"
}
