# filename: infra-aws/stage3-lb/main.tf
# Code Generated by Sidekick is for learning and experimentation purposes only.

variable "aws_region" { type = string }
variable "cluster_name" { type = string }
variable "app_namespace" { default = "ibts-app" }
variable "app_service_name" { default = "api-gateway" }
variable "app_port" { default = 8084 }
variable "allowed_cidrs" { default = ["0.0.0.0/0"] } # restrict to your IP while testing
variable "node_security_group_id" {
  type    = string
  default = null # set this if your nodes do not use the EKS primary cluster SG
}

provider "aws" { region = var.aws_region }

data "aws_eks_cluster" "eks" { name = var.cluster_name }
data "aws_eks_cluster_auth" "eks" { name = var.cluster_name }

provider "kubernetes" {
  host                   = data.aws_eks_cluster.eks.endpoint
  cluster_ca_certificate = base64decode(data.aws_eks_cluster.eks.certificate_authority[0].data)
  token                  = data.aws_eks_cluster_auth.eks.token
}

data "aws_vpc" "this" {
  tags = { Name = "${var.cluster_name}-vpc" }
}

data "aws_subnets" "public" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.this.id]
  }
  filter {
    name   = "tag:kubernetes.io/role/elb"
    values = ["1"]
  }
}

locals {
  node_sg_id = coalesce(var.node_security_group_id, data.aws_eks_cluster.eks.vpc_config[0].cluster_security_group_id)
}

# --- ALB security group -------------------------------------------------------
resource "aws_security_group" "alb" {
  name        = "${var.cluster_name}-alb-sg"
  description = "ALB for api-gateway"
  vpc_id      = data.aws_vpc.this.id

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = var.allowed_cidrs
    description = "HTTP from allowed CIDRs"
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "${var.cluster_name}-alb-sg" }
}

# --- Load balancer, target group, listener ------------------------------------
resource "aws_lb" "api" {
  name               = "${var.cluster_name}-api-alb"
  load_balancer_type = "application"
  internal           = false
  security_groups    = [aws_security_group.alb.id]
  subnets            = data.aws_subnets.public.ids
}

resource "aws_lb_target_group" "api_gateway" {
  name                 = "${var.cluster_name}-api-gw-tg"
  port                 = var.app_port
  protocol             = "HTTP"
  vpc_id               = data.aws_vpc.this.id
  target_type          = "ip" # pods register by IP
  deregistration_delay = 30

  health_check {
    enabled             = true
    path                = "/actuator/health"
    port                = "traffic-port"
    protocol            = "HTTP"
    matcher             = "200"
    interval            = 15
    timeout             = 5
    healthy_threshold   = 2
    unhealthy_threshold = 3
  }
}

resource "aws_lb_listener" "http" {
  load_balancer_arn = aws_lb.api.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.api_gateway.arn
  }
}

# --- Let the ALB reach the pods (pod port, not NodePort) ----------------------
resource "aws_security_group_rule" "alb_to_pods" {
  type                     = "ingress"
  from_port                = var.app_port
  to_port                  = var.app_port
  protocol                 = "tcp"
  security_group_id        = local.node_sg_id
  source_security_group_id = aws_security_group.alb.id
  description              = "ALB to api-gateway pods"
}

# --- Bind the target group to the Kubernetes Service --------------------------
resource "kubernetes_manifest" "api_gateway_tgb" {
  manifest = {
    apiVersion = "elbv2.k8s.aws/v1beta1"
    kind       = "TargetGroupBinding"
    metadata = {
      name      = "api-gateway-tgb"
      namespace = var.app_namespace
    }
    spec = {
      serviceRef     = { name = var.app_service_name, port = var.app_port }
      targetGroupARN = aws_lb_target_group.api_gateway.arn
      targetType     = "ip"
      # No "networking" block on purpose: the controller won't edit security groups.
    }
  }

  depends_on = [aws_lb_listener.http, aws_security_group_rule.alb_to_pods]
}


output "alb_dns_name" {
  value = aws_lb.api.dns_name
}

output "target_group_arn" {
  value = aws_lb_target_group.api_gateway.arn
}
