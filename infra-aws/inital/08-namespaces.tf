# ==============================================================================
# 1. KUBERNETES NAMESPACES DEFINITION
# ==============================================================================
# ── ibts-app namespace — all payment microservices
resource "kubernetes_namespace" "ibts_app" {
  metadata {
    name = "ibts-app"
    labels = {
      name        = "ibts-app"
      environment = var.environment
    }
  }

  depends_on = [module.eks]
}

# ── ibts-observability namespace — prometheus, grafana, loki, tempo
resource "kubernetes_namespace" "ibts_observability" {
  metadata {
    name = "ibts-observability"
    labels = {
      name        = "ibts-observability"
      environment = var.environment
    }
  }

  depends_on = [module.eks]
}

# ==============================================================================
# 2. NAMESPACE HARD RESOURCE QUOTAS (COST CONTROL CAP)
# ==============================================================================
# ── Resource Quota for ibts-app
# Prevents any single app from consuming all Spot node capacity
resource "kubernetes_resource_quota" "ibts_app" {
  metadata {
    name      = "ibts-app-quota"
    namespace = kubernetes_namespace.ibts_app.metadata[0].name
  }

  spec {
    hard = {
      # Total CPU that all pods combined can REQUEST
      # Requests determine scheduling; limits are the cap
      "requests.cpu"    = "2"
      "requests.memory" = "4Gi"

      # Upper ceiling — pods can burst but not above this
      "limits.cpu"    = "4"
      "limits.memory" = "6Gi"

      # Max number of pods in namespace — safety net
      "pods" = "20"
    }
  }
}

# ── Resource Quota for ibts-observability
# Observability tools are secondary — app services get priority
resource "kubernetes_resource_quota" "ibts_observability" {
  metadata {
    name      = "ibts-observability-quota"
    namespace = kubernetes_namespace.ibts_observability.metadata[0].name
  }

  spec {
    hard = {
      "requests.cpu"    = "1"
      "requests.memory" = "2Gi"
      "limits.cpu"      = "2"
      "limits.memory"   = "3Gi"
      "pods"            = "15"
    }
  }
}

# ==============================================================================
# 3. KUBERNETES SERVICEACCOUNTS LINKED TO AWS IRSA ROLES
# ==============================================================================
resource "kubernetes_service_account" "payment_switch" {
  metadata {
    name      = "payment-switch"
    namespace = kubernetes_namespace.ibts_app.metadata[0].name
    annotations = {
      # This annotation is what IRSA reads to inject AWS credentials into the pod
      "eks.amazonaws.com/role-arn" = module.irsa_payment_switch.iam_role_arn
    }
  }

  # 🚀 FIXED: Guarantees the namespace exists before trying to place a service account inside it
  depends_on = [kubernetes_namespace.ibts_app]
}

resource "kubernetes_service_account" "payment_router" {
  metadata {
    name      = "payment-router"
    namespace = kubernetes_namespace.ibts_app.metadata[0].name
    annotations = {
      "eks.amazonaws.com/role-arn" = module.irsa_payment_router.iam_role_arn
    }
  }

  # 🚀 FIXED: Guarantees the namespace exists before trying to place a service account inside it
  depends_on = [kubernetes_namespace.ibts_app]
}

resource "kubernetes_service_account" "idempotency_guard" {
  metadata {
    name      = "idempotency-guard"
    namespace = kubernetes_namespace.ibts_app.metadata[0].name
    annotations = {
      "eks.amazonaws.com/role-arn" = module.irsa_idempotency_guard.iam_role_arn
    }
  }

  # 🚀 FIXED: Guarantees the namespace exists before trying to place a service account inside it
  depends_on = [kubernetes_namespace.ibts_app]
