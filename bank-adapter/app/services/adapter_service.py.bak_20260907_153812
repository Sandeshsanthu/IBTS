import time
import httpx
import structlog
import pybreaker

from app.models import AdapterRequest, AdapterResponse
from app.config import settings
from app.transformers.transformer_factory import get_transformer
from app.circuit_breaker.breaker_registry import get_breaker

logger = structlog.get_logger()


class AdapterService:

    async def send(self, req: AdapterRequest) -> AdapterResponse:
        breaker     = get_breaker(req.bankCode)
        transformer = get_transformer(req.bankCode)
        payload     = transformer.to_bank_payload(req)
        start_ms    = int(time.time() * 1000)

        # ── NO manual open guard here ──────────────────────────────────────
        # pybreaker handles open / half-open / closed entirely inside
        # breaker.call() in _post().
        #
        # open + within timeout  → breaker.call() raises CircuitBreakerError
        # open + timeout expired → breaker.call() transitions to half_open,
        #                          allows the probe through
        # half_open + success    → breaker closes automatically
        # half_open + failure    → breaker re-opens, new timeout starts

        attempts = 0

        # ── PRIMARY ────────────────────────────────────────────────────────
        try:
            attempts += 1
            raw = await self._post(req.primaryEndpoint, payload,
                                   settings.primary_timeout_seconds, breaker)
            normalized = transformer.from_bank_response(raw)
            if normalized["status"] == "SUCCESS":
                logger.info("primary_success", txn=req.transactionId,
                            bank=req.bankCode)
                return AdapterResponse(
                    transactionId   = req.transactionId,
                    bankCode        = req.bankCode,
                    status          = "SUCCESS",
                    bankReferenceId = normalized["bankReferenceId"],
                    resolvedVia     = "PRIMARY",
                    attempts        = attempts,
                    responseTimeMs  = int(time.time() * 1000) - start_ms,
                )
            raise ValueError(f"Bank returned non-success: {normalized}")

        except pybreaker.CircuitBreakerError:
            # Breaker is open and reset_timeout has NOT yet expired
            logger.warning("circuit_open", bankCode=req.bankCode)
            return self._failed(req, start_ms, attempts,
                                "CIRCUIT_OPEN",
                                f"Circuit breaker open for {req.bankCode}")

        except (httpx.HTTPStatusError, httpx.TimeoutException,
                httpx.ConnectError, ValueError) as primary_err:
            logger.warning("primary_failed", txn=req.transactionId,
                           bank=req.bankCode, error=str(primary_err))

            # Don't retry on 4xx — client error
            if (isinstance(primary_err, httpx.HTTPStatusError)
                    and primary_err.response.status_code < 500):
                return self._failed(req, start_ms, attempts,
                                    "CLIENT_ERROR",
                                    str(primary_err))

        # ── FALLBACK ───────────────────────────────────────────────────────
        try:
            attempts += 1
            raw = await self._post(req.fallbackEndpoint, payload,
                                   settings.fallback_timeout_seconds, breaker)
            normalized = transformer.from_bank_response(raw)
            if normalized["status"] == "SUCCESS":
                logger.info("fallback_success", txn=req.transactionId,
                            bank=req.bankCode)
                return AdapterResponse(
                    transactionId   = req.transactionId,
                    bankCode        = req.bankCode,
                    status          = "SUCCESS",
                    bankReferenceId = normalized["bankReferenceId"],
                    resolvedVia     = "FALLBACK",
                    attempts        = attempts,
                    responseTimeMs  = int(time.time() * 1000) - start_ms,
                )
            raise ValueError(f"Fallback non-success: {normalized}")

        except pybreaker.CircuitBreakerError:
            logger.warning("circuit_open_fallback", bankCode=req.bankCode)
            return self._failed(req, start_ms, attempts,
                                "CIRCUIT_OPEN",
                                f"Circuit breaker open for {req.bankCode}")

        except Exception as fallback_err:
            logger.error("fallback_failed", txn=req.transactionId,
                         bank=req.bankCode, error=str(fallback_err))
            return self._failed(req, start_ms, attempts,
                                "BANK_UNREACHABLE",
                                "Both primary and fallback failed")

    # ── Helpers ───────────────────────────────────────────────────────────

    async def _post(self, url: str, payload: dict,
                    timeout: float,
                    breaker: pybreaker.CircuitBreaker) -> dict:
        async with httpx.AsyncClient(timeout=timeout) as client:
            try:
                resp = await client.post(url, json=payload)
                resp.raise_for_status()
                data = resp.json()
                breaker.call(lambda: None)        # success path → counter resets
                return data
            except (httpx.HTTPStatusError,
                    httpx.TimeoutException,
                    httpx.ConnectError) as exc:
                captured = exc
                try:
                    def _fail():
                        raise captured
                    breaker.call(_fail)           # counter++; at fail_max → OPEN
                except pybreaker.CircuitBreakerError:
                    raise
                except Exception:
                    pass
                raise

    def _failed(self, req: AdapterRequest, start_ms: int,
                attempts: int, code: str, msg: str) -> AdapterResponse:
        return AdapterResponse(
            transactionId  = req.transactionId,
            bankCode       = req.bankCode,
            status         = "FAILED",
            resolvedVia    = "NONE",
            attempts       = attempts,
            responseTimeMs = int(time.time() * 1000) - start_ms,
            errorCode      = code,
            errorMessage   = msg,
        )
