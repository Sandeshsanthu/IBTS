# Code Generated by Sidekick is for learning and experimentation purposes only.
# filename: metrics/fluent-bit/fluent-bit.conf

[SERVICE]
    Flush        5
    Daemon       Off
    Log_Level    info
    Parsers_File parsers.conf

# Tail all IBTS container logs from Docker
[INPUT]
    Name              tail
    Tag               ibts.*
    Path              /var/lib/docker/containers/*/*.log
    Parser            docker
    DB                /tmp/fluent-bit.db
    Mem_Buf_Limit     10MB
    Skip_Long_Lines   On
    Refresh_Interval  10

# Keep only ibts- containers
[FILTER]
    Name   grep
    Match  ibts.*
    Regex  container_name ibts-

# Parse JSON log body if present
[FILTER]
    Name   parser
    Match  ibts.*
    Key_Name log
    Parser json_log
    Reserve_Data On

# Enrich with container metadata
[FILTER]
    Name         docker_metadata
    Match        ibts.*

# Ship to Elasticsearch
[OUTPUT]
    Name  es
    Match ibts.*
    Host  elasticsearch
    Port  9200
    Index ibts-logs
    Type  _doc
    Logstash_Format On
    Logstash_Prefix ibts-logs
    Logstash_DateFormat %Y.%m.%d
    Retry_Limit 5
