{
  "id": null,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "uid": "ibts-executive",
  "title": "IBTS — D1 Executive View",
  "tags": ["ibts", "executive", "slo"],
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Payment TPS",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 5 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "expr": "sum(rate(ibts_payment_initiated_total[1m]))", "legendFormat": "TPS" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Success Rate",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 5 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "targets": [{ "expr": "100 * sum(rate(ibts_payment_initiated_total{status='SUCCESS'}[5m])) / sum(rate(ibts_payment_initiated_total[5m]))", "legendFormat": "Success %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "value": null, "color": "red" }, { "value": 95, "color": "yellow" }, { "value": 99, "color": "green" }] } } }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Failure Rate",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 5 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "targets": [{ "expr": "100 * sum(rate(ibts_payment_initiated_total{status='FAILED'}[5m])) / sum(rate(ibts_payment_initiated_total[5m]))", "legendFormat": "Failure %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 10, "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "yellow" }, { "value": 3, "color": "red" }] } } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p99 Latency",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 5 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 3, "color": "yellow" }, { "value": 5, "color": "red" }] } },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le)(rate(ibts_payment_end_to_end_latency_seconds_bucket[5m])))", "legendFormat": "p99" }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 } }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Availability",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 5 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "targets": [{ "expr": "100 * avg(ibts_service_availability_ratio)", "legendFormat": "Availability %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "value": null, "color": "red" }, { "value": 99, "color": "yellow" }, { "value": 99.9, "color": "green" }] } } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Unknown Transactions",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 1, "color": "yellow" }, { "value": 10, "color": "red" }] } },
      "targets": [{ "expr": "sum(increase(ibts_payment_unknown_total[24h]))", "legendFormat": "Unknown (24h)" }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Payment TPS — 24h Trend",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(ibts_payment_initiated_total{status='SUCCESS'}[5m]))", "legendFormat": "Successful" },
        { "expr": "sum(rate(ibts_payment_initiated_total{status='FAILED'}[5m]))", "legendFormat": "Failed" },
        { "expr": "sum(rate(ibts_payment_initiated_total{status='UNKNOWN'}[5m]))", "legendFormat": "Unknown" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency Percentiles — 24h Trend",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le)(rate(ibts_payment_end_to_end_latency_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le)(rate(ibts_payment_end_to_end_latency_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le)(rate(ibts_payment_end_to_end_latency_seconds_bucket[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Success % & Availability — 24h Trend",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "targets": [
        { "expr": "100 * sum(rate(ibts_payment_initiated_total{status='SUCCESS'}[5m])) / sum(rate(ibts_payment_initiated_total[5m]))", "legendFormat": "Success %" },
        { "expr": "100 * avg(ibts_service_availability_ratio)", "legendFormat": "Availability %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 90, "max": 100 } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Unknown Transactions — Running Total",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (payee_bank)(increase(ibts_payment_unknown_total[5m]))", "legendFormat": "{{ payee_bank }}" }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
