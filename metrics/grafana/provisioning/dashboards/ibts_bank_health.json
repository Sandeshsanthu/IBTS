      "title": "ICICI - Error Rate",
      "gridPos": { "x": 12, "y": 14, "w": 6, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by (failure_type)(rate(ibts_bank_failures_total{bank_code=\"ICICI\"}[1m]))", "legendFormat": "{{ failure_type }}" }
