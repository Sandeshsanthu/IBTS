      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (le)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"YESBANK\"}[5m])))",
        "legendFormat": "YESBANK p99"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    // ── HDFC ROW ─────────────────────────────────────────────────────────────

    { "id": 100, "type": "row", "title": "🏦 HDFC", "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 }, "collapsed": false },
    {
      "id": 101,
      "type": "timeseries",
      "title": "HDFC - Request Latency (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"HDFC\", endpoint_type=~\"$endpoint_type\"}[5m])))", "legendFormat": "p50 {{ endpoint_type }}" },
        { "expr": "histogram_quantile(0.95, sum by (le, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"HDFC\", endpoint_type=~\"$endpoint_type\"}[5m])))", "legendFormat": "p95 {{ endpoint_type }}" },
        { "expr": "histogram_quantile(0.99, sum by (le, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"HDFC\", endpoint_type=~\"$endpoint_type\"}[5m])))", "legendFormat": "p99 {{ endpoint_type }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "HDFC - Error Rate",
      "gridPos": { "x": 12, "y": 5, "w": 6, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by (failure_type)(rate(ibts_bank_failures_total{bank_code=\"HDFC\"}[1m]))", "legendFormat": "{{ failure_type }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "steps": [ { "value": null, "color": "green" }, { "value": 0.1, "color": "red" } ] }
        }
      }
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "HDFC - Timeout Rate",
      "gridPos": { "x": 18, "y": 5, "w": 6, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(ibts_bank_failures_total{bank_code=\"HDFC\", failure_type=\"timeout\"}[1m]))", "legendFormat": "timeout/s" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "steps": [ { "value": null, "color": "green" }, { "value": 0.05, "color": "red" } ] }
        }
      }
    },

    // ── ICICI ROW ────────────────────────────────────────────────────────────

    { "id": 200, "type": "row", "title": "🏦 ICICI", "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 }, "collapsed": false },
    {
      "id": 201,
      "type": "timeseries",
      "title": "ICICI - Request Latency (p50 / p95 / p99)",
