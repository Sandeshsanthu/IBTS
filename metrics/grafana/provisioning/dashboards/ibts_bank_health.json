        "thresholds": {
          "steps": [
            { "value": null, "color": "green" },
            { "value": 1,    "color": "yellow" },
            { "value": 3,    "color": "red" }
          ]
        }
      },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (le)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"ICICI\"}[5m])))",
        "legendFormat": "ICICI p99"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "SBI - p99 Latency",
      "gridPos": { "x": 18, "y": 0, "w": 3, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "value": null, "color": "green" },
            { "value": 1,    "color": "yellow" },
            { "value": 3,    "color": "red" }
          ]
        }
      },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (le)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"SBI\"}[5m])))",
        "legendFormat": "SBI p99"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
