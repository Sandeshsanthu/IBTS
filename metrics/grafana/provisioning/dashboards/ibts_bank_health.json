{
  "id": null,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "uid": "ibts-bank-health",
  "title": "IBTS - Bank Health",
  "tags": ["ibts", "bank", "health"],
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "templating": {
    "list": [
      {
        "name": "bank",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(ibts_bank_request_latency_seconds_bucket, bank_code)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "endpoint_type",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(ibts_bank_request_latency_seconds_bucket, endpoint_type)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [

    // ── TOP SUMMARY ROW ──────────────────────────────────────────────────────

    {
      "id": 1,
      "type": "stat",
      "title": "HDFC - Success %",
      "gridPos": { "x": 0, "y": 0, "w": 3, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "thresholds": {
          "steps": [
            { "value": null,  "color": "red" },
            { "value": 0.95,  "color": "yellow" },
            { "value": 0.99,  "color": "green" }
          ]
        }
      },
      "targets": [{
        "expr": "sum(rate(ibts_payment_initiated_total{status=\"SUCCESS\", payee_bank=\"HDFC\"}[5m])) / sum(rate(ibts_payment_initiated_total{payee_bank=\"HDFC\"}[5m]))",
        "legendFormat": "HDFC"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "ICICI - Success %",
      "gridPos": { "x": 3, "y": 0, "w": 3, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "thresholds": {
          "steps": [
            { "value": null,  "color": "red" },
            { "value": 0.95,  "color": "yellow" },
            { "value": 0.99,  "color": "green" }
          ]
        }
      },
      "targets": [{
        "expr": "sum(rate(ibts_payment_initiated_total{status=\"SUCCESS\", payee_bank=\"ICICI\"}[5m])) / sum(rate(ibts_payment_initiated_total{payee_bank=\"ICICI\"}[5m]))",
        "legendFormat": "ICICI"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SBI - Success %",
      "gridPos": { "x": 6, "y": 0, "w": 3, "h": 4 },
