      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"YESBANK\", endpoint_type=~\"$endpoint_type\"}[5m])))", "legendFormat": "p50 {{ endpoint_type }}" },
        { "expr": "histogram_quantile(0.95, sum by (le, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"YESBANK\", endpoint_type=~\"$endpoint_type\"}[5m])))", "legendFormat": "p95 {{ endpoint_type }}" },
        { "expr": "histogram_quantile(0.99, sum by (le, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"YESBANK\", endpoint_type=~\"$endpoint_type\"}[5m])))", "legendFormat": "p99 {{ endpoint_type }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 402,
      "type": "timeseries",
      "title": "YESBANK - Error Rate",
      "gridPos": { "x": 12, "y": 32, "w": 6, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by (failure_type)(rate(ibts_bank_failures_total{bank_code=\"YESBANK\"}[1m]))", "legendFormat": "{{ failure_type }}" }
