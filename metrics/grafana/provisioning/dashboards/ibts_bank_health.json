    {
      "id": 301,
      "type": "timeseries",
      "title": "SBI - Request Latency (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"SBI\", endpoint_type=~\"$endpoint_type\"}[5m])))", "legendFormat": "p50 {{ endpoint_type }}" },
        { "expr": "histogram_quantile(0.95, sum by (le, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"SBI\", endpoint_type=~\"$endpoint_type\"}[5m])))", "legendFormat": "p95 {{ endpoint_type }}" },
        { "expr": "histogram_quantile(0.99, sum by (le, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"SBI\", endpoint_type=~\"$endpoint_type\"}[5m])))", "legendFormat": "p99 {{ endpoint_type }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
