    },

    // ── YESBANK ROW ──────────────────────────────────────────────────────────

    { "id": 400, "type": "row", "title": "🏦 YESBANK", "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 }, "collapsed": false },
    {
      "id": 401,
      "type": "timeseries",
      "title": "YESBANK - Request Latency (p50 / p95 / p99)",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
