    // ── CROSS-BANK COMPARISON ROW ─────────────────────────────────────────────

    { "id": 500, "type": "row", "title": "📊 Cross-Bank Comparison", "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 }, "collapsed": false },
    {
      "id": 501,
      "type": "timeseries",
      "title": "All Banks - p99 Latency Comparison",
      "gridPos": { "x": 0, "y": 41, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, bank_code)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=~\"$bank\"}[5m])))", "legendFormat": "{{ bank_code }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 502,
      "type": "timeseries",
      "title": "All Banks - Error Rate Comparison",
      "gridPos": { "x": 12, "y": 41, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by (bank_code)(rate(ibts_bank_failures_total{bank_code=~\"$bank\"}[1m]))", "legendFormat": "{{ bank_code }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 503,
      "type": "bargauge",
      "title": "All Banks - Success % Ranking",
      "description": "Higher is better — red means SLA breach",
      "gridPos": { "x": 0, "y": 49, "w": 12, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "thresholds": {
          "steps": [
            { "value": null, "color": "red" },
            { "value": 0.95, "color": "yellow" },
            { "value": 0.99, "color": "green" }
          ]
        }
      },
      "targets": [
        { "expr": "sum(rate(ibts_payment_initiated_total{status=\"SUCCESS\", payee_bank=\"HDFC\"}[5m])) / sum(rate(ibts_payment_initiated_total{payee_bank=\"HDFC\"}[5m]))", "legendFormat": "HDFC" },
        { "expr": "sum(rate(ibts_payment_initiated_total{status=\"SUCCESS\", payee_bank=\"ICICI\"}[5m])) / sum(rate(ibts_payment_initiated_total{payee_bank=\"ICICI\"}[5m]))", "legendFormat": "ICICI" },
        { "expr": "sum(rate(ibts_payment_initiated_total{status=\"SUCCESS\", payee_bank=\"SBI\"}[5m])) / sum(rate(ibts_payment_initiated_total{payee_bank=\"SBI\"}[5m]))", "legendFormat": "SBI" },
        { "expr": "sum(rate(ibts_payment_initiated_total{status=\"SUCCESS\", payee_bank=\"YESBANK\"}[5m])) / sum(rate(ibts_payment_initiated_total{payee_bank=\"YESBANK\"}[5m]))", "legendFormat": "YESBANK" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 504,
      "type": "bargauge",
      "title": "All Banks - p99 Latency Ranking",
      "description": "Lower is better — red means SLA breach",
      "gridPos": { "x": 12, "y": 49, "w": 12, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "thresholds": {
          "steps": [
            { "value": null, "color": "green" },
            { "value": 1,    "color": "yellow" },
            { "value": 3,    "color": "red" }
          ]
        }
      },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"HDFC\"}[5m])))", "legendFormat": "HDFC" },
        { "expr": "histogram_quantile(0.99, sum by (le)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"ICICI\"}[5m])))", "legendFormat": "ICICI" },
        { "expr": "histogram_quantile(0.99, sum by (le)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"SBI\"}[5m])))", "legendFormat": "SBI" },
        { "expr": "histogram_quantile(0.99, sum by (le)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"YESBANK\"}[5m])))", "legendFormat": "YESBANK" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 505,
      "type": "timeseries",
      "title": "All Banks - Circuit Breaker State",
      "description": "0=closed 1=open 2=half-open",
      "gridPos": { "x": 0, "y": 57, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "ibts_circuit_breaker_state{bank_code=~\"$bank\"}", "legendFormat": "{{ bank_code }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short", "min": 0, "max": 2,
          "thresholds": { "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "red" } ] }
        }
      }
    },
    {
      "id": 506,
      "type": "timeseries",
      "title": "All Banks - Fallback Usage Rate",
      "description": "How often primary fails and fallback is used",
      "gridPos": { "x": 12, "y": 57, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "sum by (bank_code)(rate(ibts_bank_fallback_used_total{bank_code=~\"$bank\"}[1m]))", "legendFormat": "{{ bank_code }}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ]
}