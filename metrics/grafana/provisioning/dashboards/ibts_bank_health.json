        { "expr": "histogram_quantile(0.95, sum by (le, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"ICICI\", endpoint_type=~\"$endpoint_type\"}[5m])))", "legendFormat": "p95 {{ endpoint_type }}" },
        { "expr": "histogram_quantile(0.99, sum by (le, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=\"ICICI\", endpoint_type=~\"$endpoint_type\"}[5m])))", "legendFormat": "p99 {{ endpoint_type }}" }
      ],
