      "targets": [{
        "expr": "sum(rate(ibts_payment_initiated_total{status=\"SUCCESS\", payee_bank=\"SBI\"}[5m])) / sum(rate(ibts_payment_initiated_total{payee_bank=\"SBI\"}[5m]))",
        "legendFormat": "SBI"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "YESBANK - Success %",
      "gridPos": { "x": 9, "y": 0, "w": 3, "h": 4 },
