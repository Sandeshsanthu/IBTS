// Code Generated by Sidekick is for learning and experimentation purposes only.
// filename: metrics/grafana/provisioning/dashboards/ibts-overview.json
{
  "uid": "ibts-overview",
  "title": "IBTS — Payment Overview",
  "tags": ["ibts", "payments", "overview"],
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 38,
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(ibts_http_requests_total, service)",
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "bank_code",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(ibts_circuit_breaker_state, bank_code)",
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Payment Success Rate",
      "description": "% of payments completing successfully (5-min window)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "thresholds": {
          "steps": [
            { "value": null,  "color": "red"    },
            { "value": 0.95,  "color": "yellow" },
            { "value": 0.99,  "color": "green"  }
          ]
        }
      },
      "targets": [{
        "expr": "sum(rate(ibts_payment_initiated_total{status=\"SUCCESS\"}[5m])) / sum(rate(ibts_payment_initiated_total[5m]))",
        "legendFormat": "Success Rate"
      }],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Payments / sec",
      "description": "Live transaction throughput (1-min rate)",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "targets": [{
        "expr": "sum(rate(ibts_payment_initiated_total[1m]))",
        "legendFormat": "tx/s"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Active Circuit Breakers",
      "description": "Count of banks currently OPEN (state=1)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "value": null, "color": "green" },
            { "value": 1,    "color": "red"   }
          ]
        }
      },
      "targets": [{
        "expr": "count(ibts_circuit_breaker_state == 1) or vector(0)",
        "legendFormat": "Open Breakers"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "p99 End-to-End Latency",
      "description": "99th percentile full payment lifecycle latency",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "value": null, "color": "green"  },
            { "value": 3,    "color": "yellow" },
            { "value": 5,    "color": "red"    }
          ]
        }
      },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (le)(rate(ibts_payment_end_to_end_latency_seconds_bucket[5m])))",
        "legendFormat": "p99"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Rate Limit Hits / min",
      "description": "HTTP 429 responses in the last minute",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "value": null, "color": "green"  },
            { "value": 1,    "color": "yellow" },
            { "value": 50,   "color": "red"    }
          ]
        }
      },
      "targets": [{
        "expr": "sum(increase(ibts_rate_limit_hits_total[1m]))",
        "legendFormat": "429s / min"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Auth Failures / min",
      "description": "HTTP 401/403 responses — missing_key or invalid_key",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "value": null, "color": "green" },
            { "value": 1,    "color": "red"   }
          ]
        }
      },
      "targets": [{
        "expr": "sum(increase(ibts_auth_failures_total[1m]))",
        "legendFormat": "401/403 / min"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Payment Rate — NEW vs CACHED",
      "description": "NEW = fresh payment  CACHED = idempotency hit",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [{
        "expr": "sum by (idem_result)(rate(ibts_payment_initiated_total[1m]))",
        "legendFormat": "{{ idem_result }}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "End-to-End Latency Percentiles",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le)(rate(ibts_payment_end_to_end_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le)(rate(ibts_payment_end_to_end_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le)(rate(ibts_payment_end_to_end_latency_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": [{
          "matcher": { "id": "byName", "options": "p99" },
          "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
        }]
      }
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "Payment Volume by Payee Bank",
      "description": "Successful payments per second broken down by destination bank",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (payee_bank)(rate(ibts_payment_initiated_total{status=\"SUCCESS\"}[1m]))",
        "legendFormat": "{{ payee_bank }}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Payment Errors by Kind",
      "description": "validation | routing | bank_error | timeout | internal | unknown",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (error_kind)(rate(ibts_payment_errors_total[1m]))",
        "legendFormat": "{{ error_kind }}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "Circuit Breaker State per Bank",
      "description": "0=closed (green)  1=open (red)  2=half_open (yellow)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "expr": "ibts_circuit_breaker_state{bank_code=~\"$bank_code\"}",
        "legendFormat": "{{ bank_code }}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "thresholds": {
            "steps": [
              { "value": null, "color": "green"  },
              { "value": 1,    "color": "red"    },
              { "value": 2,    "color": "yellow" }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "area" } }
        }
      }
    },

    {
      "id": 12,
      "type": "timeseries",
      "title": "Bank Request Latency p99 — primary vs fallback",
      "description": "Outbound latency to bank endpoints by bank_code and endpoint_type",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (le, bank_code, endpoint_type)(rate(ibts_bank_request_latency_seconds_bucket{bank_code=~\"$bank_code\"}[5m])))",
        "legendFormat": "{{ bank_code }} {{ endpoint_type }}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 13,
      "type": "timeseries",
      "title": "Idempotency — NEW vs CACHED vs STALE",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (idem_result)(rate(ibts_idempotency_checks_total[1m]))",
        "legendFormat": "{{ idem_result }}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },

    {
      "id": 14,
      "type": "timeseries",
      "title": "Route Cache Hit Ratio",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [{
        "expr": "ibts_route_cache_hit_ratio",
        "legendFormat": "{{ service }}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "value": null, "color": "red"    },
              { "value": 0.7,  "color": "yellow" },
              { "value": 0.9,  "color": "green"  }
            ]
          }
        }
      }
    },

    {
      "id": 15,
      "type": "timeseries",
      "title": "HTTP Request Rate by Service + Code",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 8 },
      "targets": [{
        "expr": "sum by (service, http_code)(rate(ibts_http_requests_total{service=~\"$service\"}[1m]))",
        "legendFormat": "{{ service }} {{ http_code }}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },

    {
      "id": 16,
      "type": "timeseries",
      "title": "Redis Operation Latency p99",
      "gridPos": { "x": 0, "y": 44, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (le, service, operation)(rate(ibts_redis_operation_latency_seconds_bucket{service=~\"$service\"}[5m])))",
        "legendFormat": "{{ service }} {{ operation }}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 17,
      "type": "timeseries",
      "title": "DynamoDB Operation Latency p99",
      "gridPos": { "x": 12, "y": 44, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (le, service, table, operation)(rate(ibts_dynamo_operation_latency_seconds_bucket{service=~\"$service\"}[5m])))",
        "legendFormat": "{{ service }} {{ table }} {{ operation }}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 18,
      "type": "timeseries",
      "title": "Bank Failures by Type",
      "description": "timeout | http_error | connection | both_failed",
      "gridPos": { "x": 0, "y": 52, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (bank_code, failure_type)(rate(ibts_bank_failures_total{bank_code=~\"$bank_code\"}[1m]))",
        "legendFormat": "{{ bank_code }} {{ failure_type }}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },

    {
      "id": 19,
      "type": "timeseries",
      "title": "Fallback Usage Rate",
      "description": "Rate at which primary fails and fallback is attempted per bank",
      "gridPos": { "x": 12, "y": 52, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (bank_code)(rate(ibts_bank_fallback_used_total{bank_code=~\"$bank_code\"}[1m]))",
        "legendFormat": "{{ bank_code }}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.1,  "color": "yellow"},
              { "value": 1,    "color": "red"   }
            ]
          }
        }
      }
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Circuit Breaker Rejections",
      "description": "Requests short-circuited because breaker was OPEN",
      "gridPos": { "x": 0, "y": 60, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (bank_code)(rate(ibts_circuit_breaker_rejected_total{bank_code=~\"$bank_code\"}[1m]))",
        "legendFormat": "{{ bank_code }}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.1,  "color": "red"   }
            ]
          }
        }
      }
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "Circuit Breaker Fail Count per Bank",
      "description": "Consecutive failures before trip threshold — alert approaching failure_threshold",
      "gridPos": { "x": 12, "y": 60, "w": 12, "h": 8 },
      "targets": [{
        "expr": "ibts_circuit_breaker_fail_count{bank_code=~\"$bank_code\"}",
        "legendFormat": "{{ bank_code }}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "value": null, "color": "green"  },
              { "value": 3,    "color": "yellow" },
              { "value": 5,    "color": "red"    }
            ]
          }
        }
      }
    },

    {
      "id": 22,
      "type": "timeseries",
      "title": "VPA Resolution — DB vs CACHE",
      "description": "CACHE < 5 ms expected  DB < 50 ms expected",
      "gridPos": { "x": 0, "y": 68, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (bank_code, resolved_from)(rate(ibts_vpa_resolution_total{bank_code=~\"$bank_code\"}[1m]))",
        "legendFormat": "{{ bank_code }} {{ resolved_from }}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },

    {
      "id": 23,
      "type": "timeseries",
      "title": "VPA Resolution Latency p99",
      "gridPos": { "x": 12, "y": 68, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.99, sum by (le, bank_code, resolved_from)(rate(ibts_vpa_resolution_latency_seconds_bucket{bank_code=~\"$bank_code\"}[5m])))",
        "legendFormat": "{{ bank_code }} {{ resolved_from }}"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }

  ]
}
